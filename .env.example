# ============================================================
# FinSignal — Environment Configuration Template
# Copy this file to .env and configure your local values.
# NEVER commit the actual .env file with secrets to Git.
# ============================================================

APP_NAME=FinSignal
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Native PostgreSQL Configuration
# Both POSTGRES_* and DATABASE_* prefixes are supported.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finsignal_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password_here

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000"]
